{
  "GlobalConfiguration": {
    "ServiceDiscoveryProvider": {
      "Host": "consul",
      "Port": 8500,
      "Type": "Consul"
    }
  },
  "Routes": [
    {
      "UpstreamPathTemplate": "/api/gateway/Notification/Email/{everything}",
      "UpstreamHttpMethod": [ "POST" ],
      "ServiceName": "notification",
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "DownstreamPathTemplate": "/api/v1/Email/{everything}",
      "DownstreamScheme": "http"
    },
    {
      "UpstreamPathTemplate": "/api/gateway/Notification/Otp/{everything}",
      "UpstreamHttpMethod": [ "POST" ],
      "ServiceName": "notification",
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "DownstreamPathTemplate": "/api/v1/Otp/{everything}",
      "DownstreamScheme": "http"
    },
    {
      "UpstreamPathTemplate": "/api/gateway/Notification/PushNoti",
      "UpstreamHttpMethod": [ "POST" ],
      "ServiceName": "notification",
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "DownstreamPathTemplate": "/api/v1/PushNoti",
      "DownstreamScheme": "http"
    },
    {
      "UpstreamPathTemplate": "/api/gateway/Notification/SMS/{everything}",
      "UpstreamHttpMethod": [ "POST" ],
      "ServiceName": "notification",
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "DownstreamPathTemplate": "/api/v1/SMS/{everything}",
      "DownstreamScheme": "http"
    }
  ]
}